{
  "title": "Project Binding",
  "description": "agent-method-registry v2 项目绑定配置 Schema：将目标项目显式绑定到已验证的技能族实现或服务级实现，并声明副作用授权上限。",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentKind", "schemaVersion", "bindings"],
  "properties": {
    "documentKind": {
      "const": "v2-binding",
      "description": "v2 项目绑定文档判别字，固定为 v2-binding。"
    },
    "schemaVersion": {
      "const": 2,
      "description": "协议版本号，v2 项目绑定文档固定为 2。"
    },
    "bindings": {
      "type": "array",
      "description": "整族原子绑定列表；默认情况下同一 Family API 下的全部服务由同一实现原子承接。",
      "items": {
        "$ref": "#/$defs/binding"
      },
      "minItems": 0
    },
    "serviceBindings": {
      "type": "array",
      "description": "细粒度服务级混绑列表；仅允许用于标记为 mixSafe 且共享同一互操作 TCK 证明的服务。",
      "items": { "$ref": "#/$defs/serviceBinding" },
      "minItems": 1
    }
  },
  "$defs": {
    "apiIdentity": {
      "type": "object",
      "additionalProperties": false,
      "description": "被绑定的目标 Family API 身份与精确修订摘要。",
      "required": ["apiId", "apiMajor", "apiRevisionDigest"],
      "properties": {
        "apiId": {
          "type": "string",
          "pattern": "^(?:artifact\\.[a-z][a-z0-9-]*-family|project\\.[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*-family|(?!(?:artifact|project)\\.)(?:[a-z][a-z0-9-]*\\.){2,}[a-z][a-z0-9-]*-family)$",
          "description": "目标 Family API 标识。"
        },
        "apiMajor": { "type": "integer", "minimum": 1, "description": "目标 Family API 主版本号。" },
        "apiRevisionDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "目标 Family API 的 SHA-256 修订摘要。"
        }
      }
    },
    "implementationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "description": "项目选定的技能族实现身份与精确版本。",
      "required": ["familyImplementationId", "version"],
      "properties": {
        "familyImplementationId": { "type": "string", "minLength": 1, "description": "选定的技能族实现 ID。" },
        "version": { "type": "string", "minLength": 1, "description": "选定的实现语义化版本号。" }
      }
    },
    "providerSelector": {
      "type": "object",
      "additionalProperties": false,
      "description": "锁定提供方物理安装位置、所属宿主与摘要的精确选择器。",
      "required": ["scope", "pluginId", "host", "canonicalRoot", "packageDigest", "bundleDigest", "provenance"],
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["plugin", "project"],
          "description": "提供方作用域：plugin（外部插件）或 project（项目私有实现）。"
        },
        "pluginId": { "type": "string", "minLength": 1, "description": "匹配的插件或方法包标识。" },
        "projectAuthority": {
          "type": "string",
          "pattern": "^project\\.[a-z][a-z0-9-]*$",
          "description": "scope 为 project 时必填的项目归属命名空间；plugin 作用域禁止填写。"
        },
        "host": {
          "type": "string",
          "description": "绑定的宿主环境标识（支持 codex、claude-code［兼容 claude］、antigravity［兼容 antigravity-ide、agy］、kimi［兼容 kimi-code］、qoder、codebuddy、workbuddy、grok）。"
        },
        "canonicalRoot": { "type": "string", "minLength": 1, "description": "提供方安装的绝对物理根路径（禁止含 ..）。" },
        "packageDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "安装包的 SHA-256 摘要。"
        },
        "bundleDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "技能文件树的 SHA-256 摘要。"
        },
        "provenance": { "type": "string", "minLength": 1, "description": "安装来源标识。" }
      }
    },
    "conformanceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "description": "绑定时核对的符合性证明与行为验证引用。",
      "properties": {
        "deterministicAttestation": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "确定性符合性证明的 SHA-256 摘要，须与实现描述符一致。"
        },
        "behaviorQualification": {
          "type": ["string", "null"],
          "description": "行为资格验证证据路径或标识。"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "description": "单条整族级显式绑定记录，使对应技能族候选进入 ENABLED 与 EXPLICIT_BINDING 状态。",
      "required": [
        "familyId",
        "apiIdentity",
        "implementationIdentity",
        "providerSelector",
        "selectionSource",
        "conformanceEvidence"
      ],
      "properties": {
        "familyId": {
          "type": "string",
          "minLength": 1,
          "description": "去除 -family 后缀的技能族短标识（如 user-story、e2e-test）。"
        },
        "apiIdentity": { "$ref": "#/$defs/apiIdentity" },
        "implementationIdentity": { "$ref": "#/$defs/implementationIdentity" },
        "providerSelector": { "$ref": "#/$defs/providerSelector" },
        "selectionSource": {
          "type": "string",
          "enum": ["project-binding", "unique-compatible", "synthetic-migration"],
          "description": "绑定生成来源：正式项目绑定（project-binding）、唯一兼容候选（unique-compatible）或 v1 迁移合成（synthetic-migration）。"
        },
        "conformanceEvidence": { "$ref": "#/$defs/conformanceEvidence" },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "description": "当前项目授予该绑定的副作用预算上限与授权开关。",
          "required": ["sideEffectBudget", "granted"],
          "properties": {
            "sideEffectBudget": {
              "type": "string",
              "enum": ["none", "read-only", "write-authorized-artifacts", "write-review-result", "write-project-artifacts"],
              "description": "允许该绑定执行的最高副作用等级。"
            },
            "granted": { "type": "boolean", "description": "是否已授予写入型服务的执行授权。" }
          }
        }
      }
    },
    "serviceBinding": {
      "type": "object",
      "additionalProperties": false,
      "description": "单条服务级混绑记录，须额外提供跨实现互操作 TCK 证明摘要。",
      "required": [
        "familyId", "serviceId", "apiIdentity", "implementationIdentity",
        "providerSelector", "conformanceEvidence", "interopTckAttestation"
      ],
      "properties": {
        "familyId": { "type": "string", "minLength": 1, "description": "所属技能族短标识。" },
        "serviceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){2,}$",
          "description": "单独绑定的目标服务标识（该服务在 Family API 中须标记 mixSafe: true）。"
        },
        "apiIdentity": { "$ref": "#/$defs/apiIdentity" },
        "implementationIdentity": { "$ref": "#/$defs/implementationIdentity" },
        "providerSelector": { "$ref": "#/$defs/providerSelector" },
        "conformanceEvidence": { "$ref": "#/$defs/conformanceEvidence" },
        "interopTckAttestation": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "所有混绑服务实现共同通过的互操作 TCK 证明 SHA-256 摘要。"
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "description": "当前项目授予该服务绑定的副作用预算与授权开关。",
          "required": ["sideEffectBudget", "granted"],
          "properties": {
            "sideEffectBudget": {
              "type": "string",
              "enum": ["none", "read-only", "write-authorized-artifacts", "write-review-result", "write-project-artifacts"],
              "description": "允许该服务执行的最高副作用等级。"
            },
            "granted": { "type": "boolean", "description": "是否已授予写入执行授权。" }
          }
        }
      }
    }
  },
  "anyOf": [
    { "properties": { "bindings": { "type": "array", "minItems": 1 } } },
    { "required": ["serviceBindings"], "properties": { "serviceBindings": { "type": "array", "minItems": 1 } } }
  ]
}
