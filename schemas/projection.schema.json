{
  "title": "Capability Projection",
  "description": "agent-method-registry v2 能力投影 Schema：聚合 Family API、实现描述符、可信安装清单与项目绑定，按服务输出正交六维状态与候选明细。",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentKind", "schemaVersion", "inputs", "snapshotDigest", "entries"],
  "properties": {
    "documentKind": {
      "const": "v2-projection",
      "description": "v2 能力投影文档判别字，固定为 v2-projection。"
    },
    "schemaVersion": {
      "const": 2,
      "description": "协议版本号，v2 能力投影固定为 2。"
    },
    "inputs": {
      "$ref": "#/$defs/projectionInputs"
    },
    "snapshotDigest": {
      "$ref": "#/$defs/contentHash"
    },
    "entries": {
      "type": "array",
      "description": "当前 Family API 声明的全部服务及其聚合状态、候选列表。",
      "items": { "$ref": "#/$defs/projectionEntry" }
    }
  },
  "$defs": {
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "基于 canonical-json-v1 规范化计算的 SHA-256 摘要。"
    },
    "projectionInputs": {
      "type": "object",
      "additionalProperties": false,
      "description": "参与生成本能力投影的四类上游输入摘要指纹，供新鲜度与重算一致性校验。",
      "required": ["familyApiId", "familyApiMajor", "apiRevisionDigest", "implementationDigest", "inventoryDigest", "bindingDigest"],
      "properties": {
        "familyApiId": {
          "type": "string",
          "minLength": 1,
          "description": "投影对应的 Family API 标识。"
        },
        "familyApiMajor": {
          "type": "integer",
          "minimum": 1,
          "description": "投影对应的 Family API 主版本号。"
        },
        "apiRevisionDigest": { "$ref": "#/$defs/contentHash" },
        "implementationDigest": { "$ref": "#/$defs/contentHash" },
        "inventoryDigest": { "$ref": "#/$defs/contentHash" },
        "bindingDigest": { "$ref": "#/$defs/contentHash" }
      }
    },
    "projectionCandidate": {
      "type": "object",
      "additionalProperties": false,
      "description": "单个实现实例在该服务上的正交状态与信任证明明细。",
      "required": [
        "serviceId",
        "apiId",
        "apiMajor",
        "apiRevisionDigest",
        "familyImplementationId",
        "serviceImplementationId",
        "version",
        "bundleRoots",
        "installation",
        "enablement",
        "compatibility",
        "trust",
        "conformanceAttestation",
        "verificationAttestationDigest"
      ],
      "properties": {
        "serviceId": { "type": "string", "minLength": 1, "description": "目标服务标识。" },
        "apiId": { "type": "string", "minLength": 1, "description": "所属 Family API 标识。" },
        "apiMajor": { "type": "integer", "minimum": 1, "description": "所属 Family API 主版本号。" },
        "apiRevisionDigest": { "$ref": "#/$defs/contentHash" },
        "familyImplementationId": { "type": "string", "minLength": 1, "description": "候选技能族实现标识。" },
        "serviceImplementationId": { "type": "string", "minLength": 1, "description": "候选服务实现标识。" },
        "version": { "type": "string", "minLength": 1, "description": "候选实现版本号。" },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "description": "当候选已安装（INSTALLED）时附带的物理提供方定位信息。",
          "required": ["scope", "pluginId", "host", "canonicalRoot", "skillPath", "packageDigest", "bundleDigest", "provenance"],
          "properties": {
            "scope": { "type": "string", "enum": ["plugin", "project"], "description": "提供方作用域。" },
            "pluginId": { "type": "string", "minLength": 1, "description": "插件或方法包标识。" },
            "projectAuthority": { "type": "string", "pattern": "^project\\.[a-z][a-z0-9-]*$", "description": "项目本地实现的显式归属标识。" },
            "host": { "type": "string", "description": "实例所属宿主标识。" },
            "canonicalRoot": { "type": "string", "description": "安装绝对根路径。" },
            "skillPath": { "type": "string", "description": "技能相对目录路径。" },
            "packageDigest": { "$ref": "#/$defs/contentHash" },
            "bundleDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$", "description": "目录树 SHA-256 摘要。" },
            "provenance": { "type": "string", "description": "安装来源标识。" }
          }
        },
        "bundleRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "纳入目录树摘要计算的相对根目录列表。"
        },
        "installation": { "type": "string", "enum": ["INSTALLED", "NOT_INSTALLED"], "description": "候选是否已在可信安装清单中发现。" },
        "enablement": { "type": "string", "enum": ["ENABLED", "NOT_ENABLED"], "description": "候选是否已通过项目显式绑定并满足授权启用条件。" },
        "compatibility": { "type": "string", "enum": ["COMPATIBLE", "INCOMPATIBLE", "UNKNOWN"], "description": "候选实现的 API 修订摘要是否与目标契约兼容。" },
        "trust": { "type": "string", "enum": ["VERIFIED", "UNVERIFIED", "REJECTED"], "description": "文件系统边界与目录树摘要信任核验状态。" },
        "conformanceAttestation": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "实现声明的确定性符合性证明摘要。"
        },
        "verificationAttestationDigest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "核验通过后由 Registry 计算签发的提供方核验摘要。"
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "description": "匹配绑定附带的副作用预算与授权状态。",
          "required": ["sideEffectBudget", "granted"],
          "properties": {
            "sideEffectBudget": {
              "type": "string",
              "enum": ["none", "read-only", "write-authorized-artifacts", "write-review-result", "write-project-artifacts"],
              "description": "授予的最高副作用等级。"
            },
            "granted": { "type": "boolean", "description": "是否已授予写入执行权限。" }
          }
        }
      }
    },
    "projectionEntry": {
      "type": "object",
      "additionalProperties": false,
      "description": "单个标准服务在当前项目下的聚合正交状态与候选解析结果。",
      "required": [
        "ref",
        "serviceId",
        "apiId",
        "apiMajor",
        "apiRevisionDigest",
        "kind",
        "intents",
        "summary",
        "mixSafe",
        "apiRecognition",
        "installation",
        "enablement",
        "compatibility",
        "trust",
        "resolution",
        "selectionSource",
        "candidates"
      ],
      "properties": {
        "ref": { "type": "string", "minLength": 1, "description": "逻辑条目引用 ID，v2 投影中与 serviceId 相等。" },
        "serviceId": { "type": "string", "minLength": 1, "description": "标准服务标识。" },
        "apiId": { "type": "string", "minLength": 1, "description": "所属 Family API 标识。" },
        "apiMajor": { "type": "integer", "minimum": 1, "description": "所属 Family API 主版本号。" },
        "apiRevisionDigest": { "$ref": "#/$defs/contentHash" },
        "kind": { "type": "string", "enum": ["workflow", "operation"], "description": "服务形态。" },
        "intents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "服务支持的任务意图列表。"
        },
        "summary": { "type": "string", "description": "服务职责概述。" },
        "sideEffectCeiling": { "type": "string", "description": "服务声明的最高副作用上限。" },
        "mixSafe": { "type": "boolean", "description": "是否允许跨实现做服务级细粒度混绑。" },
        "apiRecognition": {
          "type": "string",
          "enum": ["STANDARD", "THIRD_PARTY", "PROJECT"],
          "description": "API 命名空间分类（标准族、第三方反向域名族或项目私有族）。"
        },
        "installation": {
          "type": "string",
          "enum": ["INSTALLED", "NOT_INSTALLED"],
          "description": "聚合安装状态。"
        },
        "enablement": {
          "type": "string",
          "enum": ["ENABLED", "NOT_ENABLED"],
          "description": "聚合启用状态（仅显式绑定可置为 ENABLED）。"
        },
        "compatibility": {
          "type": "string",
          "enum": ["COMPATIBLE", "INCOMPATIBLE", "UNKNOWN"],
          "description": "聚合契约兼容状态。"
        },
        "trust": {
          "type": "string",
          "enum": ["VERIFIED", "UNVERIFIED", "REJECTED"],
          "description": "聚合信任核验状态。"
        },
        "resolution": {
          "type": "string",
          "enum": ["NONE", "UNIQUE_COMPATIBLE", "EXPLICIT_BINDING", "AMBIGUOUS"],
          "description": "严格解析状态；仅 EXPLICIT_BINDING 可签发执行句柄与运行锁。"
        },
        "selectionSource": {
          "type": ["string", "null"],
          "enum": ["unique-compatible", "project-binding", null],
          "description": "唯一候选来源标识；未解析或存在歧义时为 null。"
        },
        "selectedCandidateId": { "type": "string", "description": "当 resolution 为 EXPLICIT_BINDING 时锁定的唯一候选身份摘要。" },
        "candidates": {
          "type": "array",
          "description": "按确定性键排序的全部候选实现实例列表。",
          "items": { "$ref": "#/$defs/projectionCandidate" }
        }
      }
    }
  }
}
